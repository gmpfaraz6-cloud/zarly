{
  "name": "shopfraz",
  "version": "1.0.0",
  "description": "A modern e-commerce platform built with React, Vite, and Supabase",
  "private": true,
  "scripts": {
    "dev": "node dev-server.js",
    "dev:admin": "cd admin && npm run dev",
    "dev:storefront": "cd storefront && npm run dev",
    "dev:both": "node dev-server.js",
    "build:admin": "cd admin && npm run build",
    "build:storefront": "cd storefront && npm run build",
    "install:admin": "cd admin && npm install",
    "install:storefront": "cd storefront && npm install",
    "install:all": "npm run install:admin && npm run install:storefront"
  },
  "type": "module",
  "keywords": [
    "e-commerce",
    "react",
    "vite",
    "supabase",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}

